# Normalize all text to LF in the repo so scripts keep working when checked out
# on Linux VMs (CRLF would break the python3 shebang: "bad interpreter: ...^M").
* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yar text eol=lf

# Test fixtures are real binary artifacts — never normalize them.
*.evtx binary
tests/data/** binary
